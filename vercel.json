{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/img/(.*)", "dest": "/api/index.py" },
    { "src": "/(css|js|images|fonts|vendor|assets|pages)/(.*)", "dest": "/sentro_clone/$1/$2" },
    { "src": "/loading-screen.html", "dest": "/sentro_clone/loading-screen.html" },
    { "src": "/(.*)", "dest": "/sentro_clone/index.html" }
  ]
}
