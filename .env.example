# Read-only backend defaults
NORYX_RPC_URL=https://robinhood-rpc.publicnode.com
NORYX_RPC_FALLBACK=https://rpc.mainnet.chain.robinhood.com
NORYX_PRIVY_APP_ID=cmvxe2afu00660hl0olfwi7dl
# Privy app IDs are public identifiers. Never put a Privy app secret here.

# Optional custom compatible indexer for endpoints that are not yet read
# directly from Pons RPC. No third-party indexer is used by default.
NORYX_INDEXER_URL=
NORYX_INDEXER_TIMEOUT=12
NORYX_INDEXER_API_KEY=
# Server-only Gemini configuration. Never expose this key in frontend code.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
NORYX_BRIDGE_URL=
NORYX_BRIDGE_API_KEY=
